# Copy to .env (gitignored) and fill in. Only needed for the Snowflake target;
# the default DuckDB target needs no credentials.

# Account identifier, e.g. ABCDEFG-XY12345 (Snowsight: your name > Account > View account details)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=WEATHER_SVC
# Absolute path to the PRIVATE key; keep it outside the repo
SNOWFLAKE_PRIVATE_KEY_PATH=C:/Users/<you>/.snowflake/keys/weather_svc_key.p8
SNOWFLAKE_WAREHOUSE=WEATHER_WH
SNOWFLAKE_DATABASE=WEATHER
SNOWFLAKE_LOADER_ROLE=WEATHER_LOADER
SNOWFLAKE_TRANSFORMER_ROLE=WEATHER_TRANSFORMER
